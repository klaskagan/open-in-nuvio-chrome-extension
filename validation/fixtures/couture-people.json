{"cast":[{"character":"Maxine Walker","characters":["Maxine Walker"],"person":{"ids":{"imdb":"nm0001401","slug":"angelina-jolie","tmdb":11701,"trakt":414505},"name":"Angelina Jolie","death":null,"gender":"female","height":169,"images":{"fanart":["media.trakt.tv/images/people/000/414/505/fanarts/medium/7a2cbe0c21.jpg.webp"],"headshot":["media.trakt.tv/images/people/000/414/505/headshots/medium/4378682868.jpg.webp"]},"summary":"Angelina Jolie is an American actress known for her roles in Eternals, Maleficent, and Mr. & Mrs. Smith. She has received numerous awards, including an Academy Award, and her films have grossed billions worldwide.","birthday":"1975-06-04","homepage":null,"biography":"Angelina Jolie is an American actress, filmmaker, and humanitarian, born in Los Angeles. She began her acting career as a child alongside her father, Jon Voight. Jolie gained critical acclaim for her role in Girl, Interrupted, earning an Academy Award. Her career highlights include starring in Mr. & Mrs. Smith, Wanted, Salt, Maleficent, and Eternals. Beyond acting, she has directed films and is widely recognized for her extensive humanitarian efforts, particularly her advocacy for refugees as a UN Special Envoy. She has received numerous accolades for her work both on and off-screen.","birthplace":"Los Angeles, California, USA ","social_ids":{"twitter":"","facebook":"","instagram":"angelinajolie","wikipedia":"Angelina_Jolie"},"updated_at":"2026-10-02T08:21:38.000Z","known_for_department":"acting"},"images":{"headshot":["media.trakt.tv/images/people/000/414/505/headshots/medium/4378682868.jpg.webp"]}},{"character":"Ada","characters":["Ada"],"person":{"ids":{"imdb":"nm16287893","slug":"anyier-anei","tmdb":5074766,"trakt":4263835},"name":"Anyier Anei","death":null,"gender":"female","height":null,"images":{"fanart":[],"headshot":["media.trakt.tv/images/people/004/263/835/headshots/medium/819806786b.jpg.webp"]},"summary":null,"birthday":null,"homepage":null,"biography":null,"birthplace"